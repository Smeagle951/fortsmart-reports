{
  "name": "fortsmart-reports",
  "version": "1.0.0",
  "description": "Relatórios técnicos agrícolas FortSmart — JSON como fonte de verdade, renderização HTML na Vercel",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "cloudflare-build": "npm run cf:build",
    "start": "next start",
    "preview:cf": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy:cf": "npm run cf:build && opennextjs-cloudflare deploy",
    "lint": "next lint",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.17.4",
    "@aws-sdk/client-s3": "^3.775.0",
    "@aws-sdk/s3-request-presigner": "^3.775.0",
    "@supabase/supabase-js": "^2.39.0",
    "@turf/area": "^7.3.4",
    "@types/leaflet": "^1.9.21",
    "chart.js": "^4.5.1",
    "dotenv": "^17.3.1",
    "framer-motion": "^11.18.2",
    "html2pdf.js": "^0.14.0",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.575.0",
    "next": "14.2.35",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-countup": "^6.5.3",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "recharts": "^3.7.0",
    "shp-write": "^0.3.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/geojson": "^7946.0.16",
    "@types/react": "19.2.14",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.54.0"
  },
  "engines": {
    "node": ">=18"
  }
}