# fortsmart_report — variáveis de ambiente (ÚNICA REFERÊNCIA)
#
# Local: copie para .env.local e preencha os valores.
# Vercel: Project → Settings → Environment Variables — use os MESMOS nomes.
# Use UM único projeto Supabase (onde está a tabela relatorios).

# --- API Node (backend) — Next chama isto em Route Handlers (não expor ao browser) ---
# Produção (Vercel): obrigatório — na cloud NÃO use 127.0.0.1 (é o próprio servidor, não o teu PC).
# FORTSMART_API_URL=https://api.fortsmart-agro.com.br
# Local com backend na máquina:
# FORTSMART_API_URL=http://127.0.0.1:3000
#
# Migração /r/[token]: tentar GET /relatorios/:token no backend antes do Supabase.
# Omitir ou =1 (padrão). Use =0 só para rollback de emergência (só Supabase).
# FORTSMART_RELATORIO_POSTGRES_FIRST=1
#
# Timeout (ms) do fetch server-side para FORTSMART_API_URL/relatorios/:token (500–120000; padrão 8000).
# Valores baixos (ex. 3000) aceleram fallback ao Supabase se o backend estiver lento.
# FORTSMART_POSTGRES_FETCH_TIMEOUT_MS=8000
#
# =1: após hit no Postgres, compara em background `dados` com o Supabase e regista divergências (logs).
# FORTSMART_RELATORIO_AUDIT_COMPARE=0
#
# Taxa de amostragem do audit (0–1; padrão 0,1 = 10%) — evita explosão de custo com AUDIT_COMPARE=1.
# FORTSMART_RELATORIO_AUDIT_SAMPLE_RATE=0.1
#
# Base (ms) do backoff do circuit breaker: após open, a próxima janela ≈ base × 2^falhas (até FORTSMART_POSTGRES_CIRCUIT_MAX_BACKOFF_MS).
# FORTSMART_POSTGRES_CIRCUIT_OPEN_MS=10000
# FORTSMART_POSTGRES_CIRCUIT_MAX_BACKOFF_MS=120000
#
# Micro-cache de `not_found` (token inexistente em Postgres+Supabase); 0 = desligado. Reduz carga em URLs inválidas.
# FORTSMART_RELATORIO_NOT_FOUND_CACHE_MS=20000
#
# Cache HTML da rota /r/[token]: desativado por defeito — `revalidate` global também cacheia 404.
# Para cache positivo no futuro, usar Edge/CDN ou cache apenas do payload com invalidação explícita.

# --- Neon (PostgreSQL) — só no SERVIDOR Next.js ---
# NUNCA use NEXT_PUBLIC_DATABASE_URL (expõe user/password no bundle do browser).
# Use em Route Handlers / Server Actions / Prisma apenas: process.env.DATABASE_URL
# Exemplo (substitua pela string do painel Neon, pooler recomendado):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# --- Obrigatórias (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# Recomendado para /r/[token] e /api/relatorio (evita depender só de RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# --- Opcionais (server também aceita sem NEXT_PUBLIC_) ---
# SUPABASE_URL=https://SEU_PROJETO.supabase.co
# SUPABASE_ANON_KEY=...

# --- Painel /admin (AgroIntelige) — palavra-passe forte, só Vercel ---
# ADMIN_PASSWORD=

# --- Opcional (mapas) ---
# NEXT_PUBLIC_MAPTILER_KEY=sua_chave_maptiler

# --- Não usar na Vercel (só local com SQLite) ---
# FORTSMART_DB_PATH=
