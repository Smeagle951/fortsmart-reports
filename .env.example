# --- Domínio oficial (relatórios / compartilhar / redirect vercel.app) ---
# Na Vercel o domínio costuma aparecer SEM https — pode colar só o host:
# NEXT_PUBLIC_CANONICAL_URL=relatorios.fortsmart-agro.com.br
# Ou URL completa:
# NEXT_PUBLIC_CANONICAL_URL=https://relatorios.fortsmart-agro.com.br
# Use o mesmo hostname que está em Domains (ASCII, ex. relatorios, não acentos no subdomínio).

# --- Opcional (mapas) — relatório visita: camada satélite MapTiler; sem chave usa Esri World Imagery ---
# NEXT_PUBLIC_MAPTILER_KEY=sua_chave_maptiler

# --- Opcional: diagnóstico rota pública /r/[token] em PRODUÇÃO (?debug=1 | ?debug=payload) ---
# Padrão em produção: desligado. Só ative para investigar e remova depois.
# ALLOW_R_ROUTE_DEBUG=1

# --- Não usar na Vercel (só local com SQLite) ---
# FORTSMART_DB_PATH=
