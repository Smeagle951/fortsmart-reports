# fortsmart_report — variáveis de ambiente (ÚNICA REFERÊNCIA)
#
# Local: copie para .env.local e preencha os valores.
# Vercel: Project → Settings → Environment Variables — use os MESMOS nomes.
# Use UM único projeto Supabase (onde está a tabela relatorios).

# --- Obrigatórias (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# Recomendado para /r/[token] e /api/relatorio (evita depender só de RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# --- Opcionais (server também aceita sem NEXT_PUBLIC_) ---
# SUPABASE_URL=https://SEU_PROJETO.supabase.co
# SUPABASE_ANON_KEY=...

# --- Opcional (mapas) ---
# NEXT_PUBLIC_MAPTILER_KEY=sua_chave_maptiler

# --- Não usar na Vercel (só local com SQLite) ---
# FORTSMART_DB_PATH=
=======
# ========== Obrigatório para /r/[token] (relatório público) ==========
# Use o MESMO projeto Supabase do app Flutter. Em Supabase: Settings → API.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Rota /r/[token] usa apenas SERVICE_ROLE (server-side). RLS é ignorado; anon key não é usada nessa rota.

# ========== Opcional (storage público, outras rotas) ==========
# NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
